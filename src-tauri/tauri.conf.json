{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Coding Setup",
  "mainBinaryName": "vibe-coding-setup",
  "version": "0.1.16",
  "identifier": "com.withgenie.vibesetup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vibe Coding Setup",
        "width": 1240,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2Q0I5NTRCQzUyODE0MTcKUldRWEZDakZTNVhMZGlGRjJINlk1UGg4Q0lubEZidmlmd1FUWDdJQktnSmpzZFc5UmlBRUdKMlIK",
      "endpoints": [
        "https://github.com/NewTurn2017/withgenie-vibe-setup/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
